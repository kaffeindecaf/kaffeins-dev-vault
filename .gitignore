/config/index.sqlite
/config/index.sqlite-shm
/config/index.sqlite-wal

# Generated exports and scratch imports
/exports/*
!/exports/.gitkeep
/imports/staging/*
!/imports/staging/README.md
/imports/raw/SOURCE_MANIFEST.json

